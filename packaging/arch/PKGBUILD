# Maintainer: ciberseguridad31 <ciberseguridad31@users.noreply.github.com>
# NEXORA OS - paquete del nucleo adaptativo
pkgname=nexora-os
pkgver=0.4.0
pkgrel=1
pkgdesc="NEXORA OS: nucleo adaptativo con agentes, perfiles y motor de kernel (NKE)"
arch=(any)
url="https://github.com/octcenano/NexoraOS"
license=(MIT)
depends=(python)
makedepends=(python-build python-installer python-wheel python-setuptools)
optdepends=(
  "ollama: modelos de IA locales"
  "systemd: unidades de servicio nexora-watchdog y nexora-nke"
)
source=("git+https://github.com/octcenano/NexoraOS.git#tag=v$pkgver")
sha256sums=('SKIP')
install=
changelog=

build() {
  cd NexoraOS
  python -m build --wheel --no-isolation
}

package() {
  cd NexoraOS
  python -m installer --destdir="$pkgdir" dist/*.whl
  # Unidades systemd opcionales (watchdog y Nexora Kernel Engine)
  install -Dm644 packaging/systemd/nexora-watchdog.service \
    "$pkgdir/usr/lib/systemd/system/nexora-watchdog.service"
  install -Dm644 packaging/systemd/nexora-nke.service \
    "$pkgdir/usr/lib/systemd/system/nexora-nke.service"
}
